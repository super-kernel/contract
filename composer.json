{
	"name": "super-kernel/contract",
	"description": "Shared interface-only application, infrastructure, reflection, and event contracts for SuperKernel components.",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": ">=8.4.27 <8.5",
		"ext-reflection": "*",
		"psr/container": "^2.0.2",
		"psr/log": "^3.0.2"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.95.27",
		"phpunit/phpunit": "^13.4.5"
	},
	"autoload": {
		"psr-4": {
			"SuperKernel\\Contract\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SuperKernel\\Contract\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
		"format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
		"test": "@php vendor/bin/phpunit"
	}
}
